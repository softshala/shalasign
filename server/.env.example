# Copy this file to .env and fill it in to enable email sending.
# Without it, the app still works — signing links are shown in the UI to copy.

# --- Option A: Microsoft 365 / Outlook work email ---
# Uses your existing work email to send the signing links.
# If emails fail to send, your Microsoft admin needs to switch on
# "Authenticated SMTP" for your mailbox (Microsoft 365 admin center →
# Users → your user → Mail → Manage email apps → tick Authenticated SMTP).
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=yourname@softshala.com
# SMTP_PASS=your-email-password
# FROM_EMAIL="SignFlow <yourname@softshala.com>"

# --- Option B: Gmail (free, up to ~500 emails/day) ---
# 1. Turn on 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords and create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL="SignFlow <yourname@gmail.com>"

# --- Option C: Brevo (free 300 emails/day, no Gmail account needed) ---
# Sign up at brevo.com → SMTP & API → SMTP keys
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# FROM_EMAIL="SignFlow <verified-sender@yourdomain.com>"

# Public URL of the app — used to build the signing links in emails.
# Locally keep localhost; after deploying, set it to your public URL.
APP_URL=http://localhost:4000

# PORT=4000
